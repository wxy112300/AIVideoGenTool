{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{H3_DIFFUSION_MODEL}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{H3_TEXT_ENCODER}}",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "VHS_LoadVideoFFmpeg",
    "inputs": {
      "video": "{{SOURCE_VIDEO}}",
      "force_rate": 24,
      "custom_width": "{{WIDTH}}",
      "custom_height": "{{HEIGHT}}",
      "frame_load_cap": 22,
      "start_time": 0,
      "format": "None"
    }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "{{PROMPT}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}",
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["23", 0],
      "ref_images.ref_image_1": ["24", 0],
      "ref_images.ref_image_2": ["25", 0],
      "ref_images.ref_image_3": ["26", 0],
      "ref_images.ref_image_4": ["27", 0],
      "ref_images.ref_image_5": ["28", 0],
      "ref_images.ref_image_6": ["29", 0],
      "ref_images.ref_image_7": ["30", 0],
      "ref_images.ref_image_8": ["31", 0],
      "ref_videos.ref_video_0": ["5", 0],
      "ref_video_audios.ref_video_audio_0": ["5", 2],
      "ref_videos.ref_video_1": ["32", 0],
      "ref_video_audios.ref_video_audio_1": ["32", 2],
      "ref_videos.ref_video_2": ["33", 0],
      "ref_video_audios.ref_video_audio_2": ["33", 2]
    }
  },
  "23": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_0}}" }
  },
  "24": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_1}}" }
  },
  "25": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_2}}" }
  },
  "26": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_3}}" }
  },
  "27": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_4}}" }
  },
  "28": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_5}}" }
  },
  "29": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_6}}" }
  },
  "30": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_7}}" }
  },
  "31": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{H3_REF_IMAGE_8}}" }
  },
  "32": {
    "class_type": "VHS_LoadVideoFFmpeg",
    "inputs": {
      "video": "{{H3_REF_VIDEO_1}}",
      "force_rate": 24,
      "custom_width": "{{WIDTH}}",
      "custom_height": "{{HEIGHT}}",
      "frame_load_cap": 362,
      "start_time": 0,
      "format": "None"
    }
  },
  "33": {
    "class_type": "VHS_LoadVideoFFmpeg",
    "inputs": {
      "video": "{{H3_REF_VIDEO_2}}",
      "force_rate": 24,
      "custom_width": "{{WIDTH}}",
      "custom_height": "{{HEIGHT}}",
      "frame_load_cap": 362,
      "start_time": 0,
      "format": "None"
    }
  },
  "7": {
    "class_type": "MiniMaxH3MotionContextLoadLatent",
    "inputs": {
      "latent_path": "{{H3_CONTEXT_LATENT_PATH}}",
      "clip_index": 1
    }
  },
  "8": {
    "class_type": "MiniMaxH3MotionContext",
    "inputs": {
      "conditioning": ["6", 0],
      "vae": ["3", 0],
      "latent": ["6", 1],
      "context_length": "22",
      "audio_context_length": 24,
      "context_frames": ["5", 0],
      "context_latent": ["7", 0],
      "audio_vae": ["4", 0],
      "context_audio": ["5", 2]
    }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "10": {
    "class_type": "PathchSageAttentionKJ",
    "inputs": {
      "model": ["1", 0],
      "sage_attention": "sageattn_qk_int8_pv_fp16_cuda",
      "allow_compile": false
    }
  },
  "11": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["10", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    }
  },
  "12": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "13": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["10", 0],
      "conditioning": ["8", 0]
    }
  },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["12", 0],
      "guider": ["13", 0],
      "sampler": ["9", 0],
      "sigmas": ["11", 0],
      "latent_image": ["6", 1]
    }
  },
  "15": {
    "class_type": "MiniMaxH3MotionContextSaveLatent",
    "inputs": {
      "latent": ["14", 0],
      "filename_prefix": "{{H3_CONTEXT_SAVE_PREFIX}}",
      "clip_index": 1
    }
  },
  "16": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["14", 0]
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["16", 0],
      "vae": ["3", 0]
    }
  },
  "18": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["16", 0],
      "image_pass": ["17", 0]
    }
  },
  "19": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["18", 0],
      "vae": ["4", 0]
    }
  },
  "20": {
    "class_type": "MiniMaxH3MotionContextTrim",
    "inputs": {
      "images": ["18", 1],
      "trim_frames": ["8", 1],
      "audio": ["19", 0],
      "fps": 24,
      "match_tail": true
    }
  },
  "21": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["20", 0],
      "audio": ["20", 1],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "22": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["21", 0],
      "filename_prefix": "{{OUTPUT_FILENAME}}",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
