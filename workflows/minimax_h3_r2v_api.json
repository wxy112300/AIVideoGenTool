{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{H3_DIFFUSION_MODEL}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{H3_TEXT_ENCODER}}",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_0}}"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_1}}"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_2}}"
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_3}}"
    }
  },
  "9": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_4}}"
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_5}}"
    }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_6}}"
    }
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_7}}"
    }
  },
  "13": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{H3_REF_IMAGE_8}}"
    }
  },
  "14": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "{{PROMPT}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}",
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["5", 0],
      "ref_images.ref_image_1": ["6", 0],
      "ref_images.ref_image_2": ["7", 0],
      "ref_images.ref_image_3": ["8", 0],
      "ref_images.ref_image_4": ["9", 0],
      "ref_images.ref_image_5": ["10", 0],
      "ref_images.ref_image_6": ["11", 0],
      "ref_images.ref_image_7": ["12", 0],
      "ref_images.ref_image_8": ["13", 0]
    }
  },
  "15": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "16": {
    "class_type": "PathchSageAttentionKJ",
    "inputs": {
      "model": ["1", 0],
      "sage_attention": "sageattn_qk_int8_pv_fp16_cuda",
      "allow_compile": false
    }
  },
  "17": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["16", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    }
  },
  "18": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "19": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["16", 0],
      "conditioning": ["14", 0]
    }
  },
  "20": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["18", 0],
      "guider": ["19", 0],
      "sampler": ["15", 0],
      "sigmas": ["17", 0],
      "latent_image": ["14", 1]
    }
  },
  "21": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["20", 0]
    }
  },
  "22": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["21", 0],
      "vae": ["3", 0]
    }
  },
  "23": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["21", 0],
      "image_pass": ["22", 0]
    }
  },
  "24": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["23", 0],
      "vae": ["4", 0]
    }
  },
  "25": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["23", 1],
      "audio": ["24", 0],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "26": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["25", 0],
      "filename_prefix": "{{OUTPUT_FILENAME}}",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
