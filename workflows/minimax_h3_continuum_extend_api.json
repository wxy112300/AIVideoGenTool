{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{H3_DIFFUSION_MODEL}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{H3_TEXT_ENCODER}}",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{H3_VIDEO_VAE}}"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "LocalVideoStudioH3LoadJointAV",
    "inputs": {
      "artifact": "{{H3_AV_INPUT_ARTIFACT}}"
    }
  },
  "6": {
    "class_type": "LocalVideoStudioH3ArtifactToContinuumState",
    "inputs": {
      "joint_av": ["5", 0],
      "source_frame_count": 0,
      "clip_index": 1,
      "capacity_frames": "Auto — largest available"
    }
  },
  "7": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "{{PROMPT}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}"
    }
  },
  "8": {
    "class_type": "PathchSageAttentionKJ",
    "inputs": {
      "model": ["1", 0],
      "sage_attention": "sageattn_qk_int8_pv_fp16_cuda",
      "allow_compile": false
    }
  },
  "9": {
    "class_type": "H3ContinuumJoin",
    "inputs": {
      "model": ["8", 0],
      "conditioning": ["7", 0],
      "latent": ["5", 0],
      "continuity": "Balanced — 22 frames",
      "extend_seconds": "{{DURATION}}",
      "audio_continuity": true,
      "first_frame_policy": "Use Continuum context; keep visual identity tokens (Recommended)",
      "preserve_last_frame": true,
      "strict_compatibility": true,
      "debug": false,
      "previous_state": ["6", 0]
    }
  },
  "10": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "11": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["9", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    }
  },
  "12": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "13": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["9", 0],
      "conditioning": ["9", 1]
    }
  },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["12", 0],
      "guider": ["13", 0],
      "sampler": ["10", 0],
      "sigmas": ["11", 0],
      "latent_image": ["9", 2]
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["14", 0],
      "vae": ["3", 0]
    }
  },
  "16": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["14", 0],
      "vae": ["4", 0]
    }
  },
  "17": {
    "class_type": "H3ContinuumFinish",
    "inputs": {
      "samples": ["14", 0],
      "images": ["15", 0],
      "audio": ["16", 0],
      "plan": ["9", 3]
    }
  },
  "18": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["17", 0],
      "audio": ["17", 1],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "19": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["18", 0],
      "filename_prefix": "{{OUTPUT_FILENAME}}",
      "format": "mp4",
      "codec": "h264"
    }
  },
  "20": {
    "class_type": "LocalVideoStudioH3SaveJointAV",
    "inputs": {
      "joint_av": ["14", 0],
      "filename": "{{H3_AV_ARTIFACT_FILENAME}}"
    }
  }
}
