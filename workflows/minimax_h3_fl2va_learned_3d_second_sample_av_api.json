{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{H3_DIFFUSION_MODEL}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{H3_TEXT_ENCODER}}",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{H3_VIDEO_VAE}}"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{INPUT_IMAGE}}"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{END_IMAGE}}"
    }
  },
  "7": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "{{PROMPT}}",
      "width": "{{H3_AV_SOURCE_WIDTH}}",
      "height": "{{H3_AV_SOURCE_HEIGHT}}",
      "length": "{{FRAMES}}",
      "first_frame": ["5", 0],
      "last_frame": ["6", 0]
    }
  },
  "8": {
    "class_type": "LocalVideoStudioH3LoadJointAV",
    "inputs": {
      "artifact": "{{H3_AV_INPUT_ARTIFACT}}"
    }
  },
  "9": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": ["8", 0]
    }
  },
  "10": {
    "class_type": "MinimaxH3LatentUpscaler3D",
    "inputs": {
      "latent": ["9", 0],
      "model_name": "{{H3_LEARNED_UPSCALER_MODEL}}",
      "mode": "target dimensions",
      "mode.width": "{{WIDTH}}",
      "mode.height": "{{HEIGHT}}",
      "align": 32,
      "enable_temporal_chunking": true,
      "force_unload": true,
      "device": "cuda",
      "precision": "bf16"
    }
  },
  "11": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": ["10", 0],
      "audio_latent": ["9", 1]
    }
  },
  "12": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "19": {
    "class_type": "PathchSageAttentionKJ",
    "inputs": {
      "model": ["1", 0],
      "sage_attention": "sageattn_qk_int8_pv_fp16_cuda",
      "allow_compile": false
    }
  },
  "13": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["19", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 0.4
    }
  },
  "14": {
    "class_type": "MiniMaxH3ShiftSigmas",
    "inputs": {
      "sigmas": ["13", 0],
      "shift_video": 12,
      "shift_audio": 3
    }
  },
  "15": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "16": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "17": {
    "class_type": "MiniMaxH3AddNoise",
    "inputs": {
      "model": ["19", 0],
      "noise": ["15", 0],
      "sigmas": ["13", 0],
      "latent_image": ["10", 0]
    }
  },
  "18": {
    "class_type": "MiniMaxH3AddNoise",
    "inputs": {
      "model": ["19", 0],
      "noise": ["16", 0],
      "sigmas": ["14", 0],
      "latent_image": ["9", 1]
    }
  },
  "20": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": ["17", 0],
      "audio_latent": ["18", 0]
    }
  },
  "21": {
    "class_type": "MiniMaxH3ConditioningUpscale",
    "inputs": {
      "conditioning": ["7", 0],
      "scale_by": "{{H3_AV_SCALE_BY}}",
      "upscale_method": "bilinear"
    }
  },
  "22": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["19", 0],
      "conditioning": ["32", 0]
    }
  },
  "32": {
    "class_type": "LocalVideoStudioH3AnchorConditioning",
    "inputs": {
      "conditioning": ["21", 0],
      "video_latent": ["10", 0],
      "strength": 0.999
    }
  },
  "23": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["25", 0],
      "guider": ["22", 0],
      "sampler": ["12", 0],
      "sigmas": ["13", 0],
      "latent_image": ["20", 0]
    }
  },
  "24": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["23", 0]
    }
  },
  "25": {
    "class_type": "DisableNoise",
    "inputs": {}
  },
  "26": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["24", 0],
      "vae": ["3", 0]
    }
  },
  "27": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["24", 0],
      "image_pass": ["26", 0]
    }
  },
  "28": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["27", 0],
      "vae": ["4", 0]
    }
  },
  "29": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["27", 1],
      "audio": ["28", 0],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "30": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["29", 0],
      "filename_prefix": "{{OUTPUT_FILENAME}}",
      "format": "mp4",
      "codec": "h264"
    }
  },
  "31": {
    "class_type": "LocalVideoStudioH3SaveJointAV",
    "inputs": {
      "joint_av": ["24", 0],
      "filename": "{{H3_AV_ARTIFACT_FILENAME}}"
    }
  }
}
