{
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{H3_DIFFUSION_MODEL}}", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{H3_TEXT_ENCODER}}", "type": "minimax", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{H3_VIDEO_VAE}}" } },
  "4": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" } },
  "5": { "class_type": "LoadImage", "inputs": { "image": "{{INPUT_IMAGE}}" } },
  "6": { "class_type": "LoadImage", "inputs": { "image": "{{END_IMAGE}}" } },
  "7": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0], "vae": ["3", 0], "first_frame": ["5", 0], "last_frame": ["6", 0],
      "prompt": "{{PROMPT}}", "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "length": "{{FRAMES}}"
    }
  },
  "8": {
    "class_type": "Load LakonLab Adapter",
    "inputs": { "model": ["1", 0], "adapter_name": "{{PI_H3_ADAPTER}}", "adapter_strength": 1 }
  },
  "9": { "class_type": "MiniMaxH3SigmaShift", "inputs": { "model": ["8", 0], "shift_video": 12, "shift_audio": 3 } },
  "10": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "11": {
    "class_type": "pi-Flow Scheduler",
    "inputs": {
      "model": ["9", 0], "steps": "{{PI_H3_STEPS}}", "min_raw_t": 0,
      "max_raw_t": "{{PI_H3_MAX_RAW_T}}", "final_step_size_scale": 0.6
    }
  },
  "12": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "13": { "class_type": "BasicGuider", "inputs": { "model": ["9", 0], "conditioning": ["7", 0] } },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["12", 0], "guider": ["13", 0], "sampler": ["10", 0], "sigmas": ["11", 0], "latent_image": ["7", 1] }
  },
  "15": { "class_type": "DWD Decode", "inputs": { "samples": ["14", 0] } },
  "16": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["14", 0], "vae": ["4", 0] } },
  "17": { "class_type": "CreateVideo", "inputs": { "images": ["15", 0], "audio": ["16", 0], "fps": 24, "bit_depth": 8 } },
  "18": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["17", 0], "filename_prefix": "{{OUTPUT_FILENAME}}", "format": "mp4", "codec": "h264" }
  }
}
