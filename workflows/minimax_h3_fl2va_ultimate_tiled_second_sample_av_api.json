{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{H3_DIFFUSION_MODEL}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{H3_TEXT_ENCODER}}",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{H3_VIDEO_VAE}}"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{INPUT_IMAGE}}"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{END_IMAGE}}"
    }
  },
  "7": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["36", 0],
      "prompt": "{{PROMPT}}",
      "width": "{{H3_AV_SOURCE_WIDTH}}",
      "height": "{{H3_AV_SOURCE_HEIGHT}}",
      "length": "{{FRAMES}}",
      "first_frame": ["5", 0],
      "last_frame": ["6", 0]
    }
  },
  "8": {
    "class_type": "LocalVideoStudioH3LoadJointAV",
    "inputs": {
      "artifact": "{{H3_AV_INPUT_ARTIFACT}}"
    }
  },
  "12": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "13": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["19", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 0.4
    }
  },
  "15": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "19": {
    "class_type": "PathchSageAttentionKJ",
    "inputs": {
      "model": ["1", 0],
      "sage_attention": "sageattn_qk_int8_pv_fp16_cuda",
      "allow_compile": false
    }
  },
  "21": {
    "class_type": "MiniMaxH3ConditioningUpscale",
    "inputs": {
      "conditioning": ["7", 0],
      "scale_by": "{{H3_AV_SCALE_BY}}",
      "upscale_method": "bilinear"
    }
  },
  "32": {
    "class_type": "MMH3LatentUpscaleWithModelParams",
    "inputs": {
      "model_name": "{{H3_LEARNED_UPSCALER_MODEL}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "device": "cuda",
      "precision": "bf16"
    }
  },
  "33": {
    "class_type": "MMH3TemporalSplitParams",
    "inputs": {
      "chunk_length": 136,
      "temporal_overlap": 17,
      "anchor_strength": 0.999
    }
  },
  "34": {
    "class_type": "MMH3SpatialSplitParams",
    "inputs": {
      "upscale_width": "{{WIDTH}}",
      "upscale_height": "{{HEIGHT}}",
      "tile_size_mode": "specific_size",
      "tile_width": 768,
      "tile_height": 576,
      "grid_rows": 2,
      "grid_cols": 3,
      "spatial_w_overlap": 128,
      "spatial_h_overlap": 128,
      "fade_width": 32,
      "fade_height": 32,
      "min_tile_size": 256,
      "overlap_mode": "earlier",
      "overlap_blend": "smoothstep",
      "masked_area_noise": 0,
      "brightness_match": false,
      "dynamic_fade": "off",
      "dynamic_fade_min": 32
    }
  },
  "35": {
    "class_type": "MMH3UltimateUpscale",
    "inputs": {
      "model": ["19", 0],
      "conditioning": ["21", 0],
      "latent": ["8", 0],
      "noise": ["15", 0],
      "sampler": ["12", 0],
      "sigmas": ["13", 0],
      "cfg": 1,
      "latent_upscale_param": ["32", 0],
      "temporal_split_param": ["33", 0],
      "spatial_split_param": ["34", 0]
    }
  },
  "24": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["35", 0]
    }
  },
  "26": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["24", 0],
      "vae": ["36", 0]
    }
  },
  "27": {
    "class_type": "VRAM_Debug",
    "inputs": {
      "empty_cache": true,
      "gc_collect": true,
      "unload_all_models": true,
      "any_input": ["24", 0],
      "image_pass": ["26", 0]
    }
  },
  "28": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["27", 0],
      "vae": ["37", 0]
    }
  },
  "29": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["27", 1],
      "audio": ["28", 0],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "30": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["29", 0],
      "filename_prefix": "{{OUTPUT_FILENAME}}",
      "format": "mp4",
      "codec": "h264"
    }
  },
  "31": {
    "class_type": "LocalVideoStudioH3SaveJointAV",
    "inputs": {
      "joint_av": ["24", 0],
      "filename": "{{H3_AV_ARTIFACT_FILENAME}}"
    }
  },
  "36": {
    "class_type": "LocalVideoStudioH3RequireGpuVAE",
    "inputs": {
      "vae": ["3", 0]
    }
  },
  "37": {
    "class_type": "LocalVideoStudioH3RequireGpuVAE",
    "inputs": {
      "vae": ["4", 0]
    }
  }
}
