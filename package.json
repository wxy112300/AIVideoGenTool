{
  "name": "ai-video-gen-tool",
  "version": "0.67.3",
  "private": true,
  "description": "Local image and video creation studio powered by ComfyUI",
  "main": "dist/electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run typecheck && vite build --config vite.config.ts && npm run build:web && tsc -p tsconfig.electron.json && node scripts/copy-bundled-comfy-nodes.mjs",
    "package:win": "npm run build && npm run package:win:built",
    "package:win:built": "electron-builder --win --x64 --publish never --config.electronDist=node_modules/electron/dist",
    "harness:comfy": "node scripts/local-runtime-harness.mjs",
    "harness:app": "node scripts/app-harness.mjs",
    "test:journeys": "vitest run --config vite.config.ts tests/user-journeys.test.ts tests/app-harness.test.ts --reporter=dot",
    "prototype:build": "node scripts/build-prototypes.mjs",
    "verify:markup-visual": "electron scripts/verify-image-markup-visual.cjs",
    "verify:ux-ui-contrast": "node scripts/check-ux-ui-text-contrast.mjs",
    "capture:c04": "node --experimental-strip-types scripts/capture-c04-electron-evidence.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vite.config.ts --exclude \"dist/**\" --exclude \"tests/library-storage.test.ts\" --exclude \"tests/bundled-assets.test.ts\" --exclude \"tests/history-performance.test.ts\" --exclude \"tests/dependency-installer.test.ts\" --exclude \"tests/dlss5-runtime.test.ts\" --exclude \"tests/aetherscale-runtime.test.ts\" --exclude \"tests/konohamaru-runtime.test.ts\" --reporter=dot --silent=passed-only",
    "test:integration": "vitest run --config vite.config.ts --exclude \"dist/**\" tests/library-storage.test.ts tests/bundled-assets.test.ts tests/history-performance.test.ts tests/dependency-installer.test.ts tests/dlss5-runtime.test.ts tests/aetherscale-runtime.test.ts tests/konohamaru-runtime.test.ts --reporter=dot",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:verbose": "vitest run --config vite.config.ts --exclude \"dist/**\" --reporter=default",
    "verify": "npm run test:all && npm run build && npm run verify:ux-ui-contrast",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.3"
  },
  "build": {
    "productName": "Local Video Studio",
    "appId": "com.wxy112300.localvideostudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "dist/web/**/*",
      "dist/electron/electron/**/*",
      "dist/electron/src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/electron/comfy_nodes",
        "to": "comfy_nodes",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "dist/electron/workflows",
        "to": "workflows"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Local-Video-Studio-${version}-win-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Local-Video-Studio-${version}-win-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "cropperjs": "1.6.2",
    "fabric": "^7.4.0",
    "lucide": "^1.28.0",
    "media-chrome": "4.19.2"
  }
}
